{
  "info": {
    "name": "Gestor Canchas API Tests",
    "_postman_id": "9d90f375-d8f5-4a3c-bd6c-9e06fbc4f8a7",
    "description": "Colección de pruebas con datos reales de la base de datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login - tc_user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tc_user\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": ["{{baseURL}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login status code is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('token', data.token);",
                  "pm.test('Token is returned', function () { pm.expect(data.token).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password - anderson_admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"andersoncontreras@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseURL}}/auth/forgot-password",
              "host": ["{{baseURL}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        }
      ]
    },
