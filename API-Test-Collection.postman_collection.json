    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": ["{{baseURL}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login status code is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.environment.set('token', data.token);",
                  "pm.test('Token is returned', function () { pm.expect(data.token).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
